{
  "name": "qwen-live-harness-workspace",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": "github:QwenLM/Qwen-Live-Harness",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/qwen-live-harness"
  ],
  "scripts": {
    "build": "npm run build --workspace qwen-live-harness",
    "typecheck": "npm run typecheck --workspace qwen-live-harness && tsc --project integration-tests/tsconfig.json --noEmit",
    "start": "node scripts/start-dev.mjs",
    "init": "node scripts/start-dev.mjs init",
    "test": "npm run test:daemon && npm run test:scripts && npm run test:integration",
    "test:daemon": "npm run test --workspace qwen-live-harness",
    "test:host": "npm run test --prefix packages/qwen-live-harness-host",
    "test:scripts": "vitest run --config scripts/tests/vitest.config.ts",
    "test:integration": "vitest run --config integration-tests/vitest.config.ts",
    "test:backends": "vitest run --config integration-tests/vitest.backends.config.ts",
    "build:host": "npm run build --prefix packages/qwen-live-harness-host",
    "typecheck:host": "npm run typecheck --prefix packages/qwen-live-harness-host",
    "check:boundaries": "node scripts/check-repository-boundaries.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:peer-source": "node scripts/qwen-code-peer-source.mjs --verify",
    "restore:peer-source": "node scripts/qwen-code-peer-source.mjs --restore",
    "lint": "eslint packages/qwen-live-harness/src integration-tests scripts --ignore-pattern '**/test-fixtures/**'",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.1.1"
  }
}
