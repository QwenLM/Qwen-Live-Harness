{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "qwen-live-harness/startup": ["../qwen-live-harness/src/startup.ts"],
      "qwen-live-harness/i18n": ["../qwen-live-harness/src/i18n/messages.ts"],
      "qwen-live-harness/subagents": [
        "../qwen-live-harness/src/subagents/types.ts"
      ]
    },
    "noEmit": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts", "vite.config.ts"]
}
