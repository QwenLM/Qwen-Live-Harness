{
  "name": "qwen-live-harness",
  "version": "0.4.3",
  "description": "Standalone realtime voice harness for Qwen Code, Qoder and other ACP agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QwenLM/Qwen-Live-Harness.git",
    "directory": "packages/qwen-live-harness"
  },
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "qwen-live-harness": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./i18n": {
      "types": "./dist/i18n/messages.d.ts",
      "import": "./dist/i18n/messages.js"
    },
    "./startup": {
      "types": "./dist/startup.d.ts",
      "import": "./dist/startup.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "import": "./dist/lifecycle.js"
    },
    "./subagents": {
      "types": "./dist/subagents/types.d.ts",
      "import": "./dist/subagents/types.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "build:ts": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "test": "vitest run",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.14.1",
    "@node-rs/jieba": "2.0.2",
    "ansi-regex": "^6.2.2",
    "prompts": "^2.4.2",
    "proper-lockfile": "^4.1.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@qwen-code/sdk": "0.1.12",
    "@types/node": "^22.13.10",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1",
    "@types/prompts": "^2.4.9"
  },
  "bugs": {
    "url": "https://github.com/QwenLM/Qwen-Live-Harness/issues"
  },
  "homepage": "https://github.com/QwenLM/Qwen-Live-Harness#readme"
}
